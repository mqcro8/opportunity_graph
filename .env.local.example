# Supabase — get these from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by API routes that write opportunities
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Extraction AI (Phase 1+)
GEMINI_API_KEY=your-gemini-api-key

# Cron secret — protects /api/ingest/* from unauthorized triggers
CRON_SECRET=your-cron-secret

# Admin — gates /admin/* and /api/admin/* (must match the Supabase user's email)
ADMIN_EMAIL=you@example.com
